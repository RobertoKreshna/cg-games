# Copy to .env.local and fill in. Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_DB_URL=postgresql://postgres.xxx:password@...pooler.supabase.com:5432/postgres

# Optional: errors (browser and edge functions) are posted to this Discord webhook.
# Set it in Vercel for the site, and as a Supabase secret for the edge functions:
#   supabase secrets set DISCORD_WEBHOOK_URL=... --project-ref <ref>
DISCORD_WEBHOOK_URL=

# Optional Supabase secret for the edge functions (not needed locally or in Vercel): the Supavisor
# *transaction* pooler string, i.e. the session pooler URL above with the port changed to 6543.
# Only worth it for groups well beyond ~30 players; the functions already release their database
# connections 5s after use (see supabase/functions/_shared/db.ts).
#   supabase secrets set DATABASE_POOLER_URL="postgresql://postgres.xxx:password@...pooler.supabase.com:6543/postgres" --project-ref <ref>
DATABASE_POOLER_URL=
